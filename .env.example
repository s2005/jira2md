# jira2md credentials.
#
# Copy to .env and fill in, or export these directly. Resolution order is
# CLI flags, then these environment variables, then a .env file. The env
# file is --env-file / JIRA2MD_ENV_FILE when given, otherwise ./.env,
# otherwise ~/.config/jira2md/.env (%APPDATA%/jira2md/.env on Windows).
# The first hit wins; env files are not merged.

# Base URL of the Jira instance (Cloud or Server/Data Center).
JIRA_URL=https://your-company.atlassian.net

# Account email. Set it for Cloud basic auth; leave it empty for a
# Server/Data Center personal access token.
JIRA_EMAIL=you@example.com

# API token (Cloud) or personal access token (Server/Data Center).
JIRA_TOKEN=your-api-token

# Auth scheme override: basic, bearer, or unset for auto-detection
# (basic when JIRA_EMAIL is set, bearer otherwise).
# JIRA_AUTH=basic
